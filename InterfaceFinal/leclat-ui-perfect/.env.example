# Supabase — L'ÉCLAT
# Copier ce fichier en `.env` (jamais commité) et remplir les vraies valeurs.
# Les valeurs sont publiées côté client, donc ne JAMAIS mettre la clé service_role ici.

# URL du projet Supabase (depuis Settings → API)
VITE_SUPABASE_URL=

# Clé anon / publishable (depuis Settings → API → Project API keys → "anon" "public")
VITE_SUPABASE_PUBLISHABLE_KEY=
